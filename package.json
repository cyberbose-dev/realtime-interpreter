{
  "name": "realtime-interpreter",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time simultaneous interpretation web app on AWS (Transcribe + Bedrock + Polly)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite web",
    "build:web": "vite build web",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "cdk": "cdk",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.10.1",
    "aws-cdk": "^2.1143.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1141.0",
    "@aws-sdk/client-polly": "^3.1141.0",
    "@smithy/eventstream-codec": "^4.5.2",
    "@smithy/signature-v4": "^5.7.4",
    "@smithy/util-utf8": "^4.5.2",
    "aws-cdk-lib": "^2.271.0",
    "constructs": "^10.8.1"
  }
}
